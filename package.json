{
  "name": "steprecover-browser-recovery",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "demo": "vite --config vite.demo.config.ts --host localhost --port 4173 --strictPort",
    "build": "npm run typecheck && vite build --config vite.demo.config.ts && vite build --config vite.extension.config.ts && node scripts/copy-extension.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/core.test.mjs"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/chrome": "^0.1.27",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.9.0",
    "vite": "^7.3.0"
  }
}
